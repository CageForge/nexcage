{
    "proxmox": {
    "storage": "local-lvm",
    "rootfs_size_gb": 8,
    "unprivileged": true
    },
    "runtime": {
    "log_level":"info",
    "log_path":"/var/log/nexcage/runtime.log",
    "routing": [
        {
            "pattern": "^(kube-ovn-.*|cilium-.*)$",
            "runtime": "crun"
        },
        {
            "pattern": "*",
            "runtime": "lxc"
        }
        ]
    },
    "network": {
        "bridge": "vmbr0"
    }
}

# Build artifacts
.zig-cache/*
zig-out/*
zig-out/**/*
.github/workflows/.zig-cache/

# Zig compiler binaries (should not be in repo)
/zig/*
!/zig/download.sh
!/zig/.gitkeep
zig-linux-x86_64-0.13.0/*

# Test reports
test-*/*
test-reports/*
!test-reports/.gitkeep

# Configuration files (user-specific)
.env
.env.*
!.env.example
# Anchored: only the local config at the root. Unanchored, this also hid
# packaging/config/config.json, the example the .deb ships.
/config.json

# Build outputs written by release.yml and scripts/build_deb_local.sh
/dist/

# Tool binaries and logs dropped at the repository root
/gitleaks
/*.log
/build_errors.txt

# Build artifacts and temp files
crun-*/*
crun-*.tar.gz
.backup/*
.cursor/*

# IDE and editor files
.vscode/*
!.vscode/settings.json.example
.idea/*
*.swp
*.swo
*~
libdriver.a

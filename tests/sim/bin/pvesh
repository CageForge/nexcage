#!/bin/bash
# Fake pvesh: next free VMID, and oci-registry-pull adds the pulled .tar to $SIM/templates.
SIM=${SIM:?}
echo "pvesh $*" >> "$SIM/calls"
# The cluster: $SIM/db rows are "vmid status name [node]", and a row with no
# node is on this host. `pct` only ever sees this host's rows, which is what
# makes the difference between the two tools visible here.
HERE=${SIM_NODE:-$(hostname)}

# fail_all means the host cannot answer at all, and that has to include pvesh:
# the checks that inject it are about nexcage refusing rather than guessing, and
# they stop meaning anything if one of the two tools still answers.
[ -e "$SIM/fail_all" ] && { cat "$SIM/fail_all" >&2; exit 13; }

case "$1 $2" in
  "get /cluster/resources")
    # The real API's --type enumeration is vm, storage, node, sdn. It rejects
    # anything else, and nexcage asked for "lxc" for three releases: every
    # lookup failed and fell back to `pct list`, which is right for a container
    # on this host and wrong for one anywhere else. This fake accepted the wrong
    # flag and so agreed with the mistake -- it refuses it now, the way Proxmox
    # does, so the tests can catch it instead of confirming it.
    want=""
    for a in "$@"; do [ "$prev_arg" = "--type" ] && want=$a; prev_arg=$a; done
    case $want in
      vm) : ;;
      "") echo "400 Parameter verification failed." >&2
          echo "type: parameter is missing" >&2; exit 2 ;;
      storage|node|sdn) printf '[]\n'; exit 0 ;;
      *)  echo "400 Parameter verification failed." >&2
          echo "type: value '$want' does not have a value in the enumeration 'vm, storage, node, sdn'" >&2
          exit 2 ;;
    esac
    # A container carries "type":"lxc"; a virtual machine would carry "qemu",
    # and one is here so the filter has something to leave out.
    #
    # $SIM/stale_cluster models what pvestatd's cache really does: the listing
    # lags a few seconds, so a container that `pct list` already sees is not in
    # it yet. A name in that file is left out of this answer.
    printf '['
    printf '{"vmid":9999,"name":"a-virtual-machine","node":"%s","status":"running","type":"qemu"}' "$HERE"
    while read -r vmid status name node; do
      [ -n "$vmid" ] || continue
      if [ -s "$SIM/stale_cluster" ] && grep -qxF "$name" "$SIM/stale_cluster" 2>/dev/null; then continue; fi
      # $SIM/stale_status makes the cached listing report an out-of-date status
      # for a name, which is what pvestatd's cache really does for a few seconds
      # after a start or a stop. The two sources can then disagree, and only a
      # real host could show that before.
      if [ -s "$SIM/stale_status" ]; then
        old_status=$(awk -v n="$name" '$1==n {print $2}' "$SIM/stale_status" 2>/dev/null)
        [ -n "$old_status" ] && status=$old_status
      fi
      printf ',{"vmid":%s,"name":"%s","node":"%s","status":"%s","type":"lxc"}' \
        "$vmid" "$name" "${node:-$HERE}" "$status"
    done < "$SIM/db"
    printf ']\n'
    ;;
  "get /nodes")
    # $SIM/nodes lists the cluster's nodes, one per line; without it there is
    # only this host, which is what a standalone Proxmox looks like.
    printf '['
    sep=""
    if [ -s "$SIM/nodes" ]; then
      while read -r n; do
        [ -n "$n" ] || continue
        printf '%s{"node":"%s","status":"online","type":"node"}' "$sep" "$n"; sep=","
      done < "$SIM/nodes"
    else
      printf '{"node":"%s","status":"online","type":"node"}' "$HERE"
    fi
    printf ']\n'
    ;;
  "get /nodes/"*/storage)
    # $SIM/node_storages holds "node storage shared" lines.
    node=$(echo "$2" | sed -n 's|/nodes/\([^/]*\)/storage|\1|p')
    printf '['
    sep=""
    if [ -s "$SIM/node_storages" ]; then
      while read -r n st shared; do
        [ "$n" = "$node" ] || continue
        printf '%s{"storage":"%s","content":"vztmpl,rootdir","shared":%s}' "$sep" "$st" "${shared:-0}"; sep=","
      done < "$SIM/node_storages"
    else
      printf '{"storage":"local","content":"vztmpl,rootdir","shared":0}'
    fi
    printf ']\n'
    ;;
  "get /nodes/"*/storage/*/content)
    # What templates a node can see. $SIM/node_templates holds "node volid"
    # lines; without a line for that node it has none, which is what makes the
    # "the template is not there" check mean something.
    node=$(echo "$2" | sed -n 's|/nodes/\([^/]*\)/storage/.*|\1|p')
    want_storage=$(echo "$2" | sed -n 's|/nodes/[^/]*/storage/\([^/]*\)/content.*|\1|p')
    printf '['
    sep=""
    while read -r n volid; do
      [ "$n" = "$node" ] || continue
      # a volid is "<storage>:vztmpl/<file>", so it belongs to one storage
      [ "${volid%%:*}" = "$want_storage" ] || continue
      printf '%s{"volid":"%s","content":"vztmpl","format":"tzst"}' "$sep" "$volid"
      sep=","
    done < "${SIM}/node_templates" 2>/dev/null
    printf ']\n'
    ;;
  "create /nodes/"*/lxc)
    # Create on a node: --vmid N --ostemplate T --hostname H ...
    node=$(echo "$2" | sed -n 's|/nodes/\([^/]*\)/lxc|\1|p')
    vmid=""; host=""
    shift 2
    while [ $# -gt 0 ]; do
      case $1 in
        --vmid) vmid=$2; shift 2 ;;
        --hostname) host=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$vmid" ] || { echo "no vmid given" >&2; exit 2; }
    echo "$vmid stopped $host $node" >> "$SIM/db"
    ;;
  "get /nodes/"*/lxc/*/snapshot)
    # The node's snapshot list, from the same per-container file the fake pct
    # writes: name, snaptime, description and parent, plus the "current" entry
    # the real API adds for where the container is now.
    vmid=$(echo "$2" | sed -n 's|.*/lxc/\([0-9]*\)/snapshot|\1|p')
    awk -v v="$vmid" '$1==v {f=1} END {exit !f}' "$SIM/db" || {
      echo "Configuration file 'nodes/x/lxc/$vmid.conf' does not exist" >&2; exit 2; }
    printf '['
    parent=""
    if [ -s "$SIM/snaps.$vmid" ]; then
      while read -r name t desc; do
        [ -n "$name" ] || continue
        printf '{"name":"%s","snaptime":%s' "$name" "$t"
        [ -n "$desc" ] && printf ',"description":"%s"' "$desc"
        [ -n "$parent" ] && printf ',"parent":"%s"' "$parent"
        printf '},'
        parent=$name
      done < "$SIM/snaps.$vmid"
    fi
    printf '{"name":"current","description":"You are here!"'
    [ -n "$parent" ] && printf ',"parent":"%s"' "$parent"
    printf ',"running":0}]\n'
    ;;
  "create /nodes/"*/lxc/*/snapshot/*/rollback)
    vmid=$(echo "$2" | sed -n 's|.*/lxc/\([0-9]*\)/snapshot/.*|\1|p')
    name=$(echo "$2" | sed -n 's|.*/snapshot/\([^/]*\)/rollback|\1|p')
    shift 2
    start=0
    while [ $# -gt 0 ]; do case $1 in --start) start=$2; shift 2 ;; *) shift ;; esac; done
    awk -v v="$vmid" '$1==v {f=1} END {exit !f}' "$SIM/db" || {
      echo "Configuration file 'nodes/x/lxc/$vmid.conf' does not exist" >&2; exit 2; }
    awk -v n="$name" '$1==n {f=1} END {exit !f}' "$SIM/snaps.$vmid" 2>/dev/null || {
      echo "snapshot '$name' does not exist" >&2; exit 2; }
    # As pct does: a running container is stopped before the rollback.
    awk -v v="$vmid" '$1==v {$2="stopped"} {print}' "$SIM/db" > "$SIM/db.tmp" && mv "$SIM/db.tmp" "$SIM/db"
    echo "rollback: $name" >> "$SIM/conf.$vmid"
    if [ "$start" = 1 ]; then
      awk -v v="$vmid" '$1==v {$2="running"} {print}' "$SIM/db" > "$SIM/db.tmp" && mv "$SIM/db.tmp" "$SIM/db"
    fi
    ;;
  "create /nodes/"*/lxc/*/snapshot)
    # A snapshot through the node's API: --snapname N [--description D], with
    # the same rules as the fake pct.
    vmid=$(echo "$2" | sed -n 's|.*/lxc/\([0-9]*\)/snapshot|\1|p')
    shift 2
    name=""; desc=""
    while [ $# -gt 0 ]; do
      case $1 in
        --snapname) name=$2; shift 2 ;;
        --description) desc=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    awk -v v="$vmid" '$1==v {f=1} END {exit !f}' "$SIM/db" || {
      echo "Configuration file 'nodes/x/lxc/$vmid.conf' does not exist" >&2; exit 2; }
    [ -n "$name" ] || { echo "400 Parameter verification failed." >&2; echo "snapname: property is missing" >&2; exit 2; }
    [ -e "$SIM/fail_snapshot" ] && { cat "$SIM/fail_snapshot" >&2; exit 255; }
    [ "$name" = current ] && { echo "unable to use snapshot name 'current' (reserved name)" >&2; exit 255; }
    awk -v n="$name" '$1==n {f=1} END {exit !f}' "$SIM/snaps.$vmid" 2>/dev/null && {
      echo "snapshot name '$name' already used" >&2; exit 255; }
    printf '%s %s %s\n' "$name" "$(date +%s)" "$desc" >> "$SIM/snaps.$vmid"
    ;;
  "create /nodes/"*/lxc/*)
    # /nodes/<node>/lxc/<vmid>/status/<action>
    path=$2
    vmid=$(echo "$path" | sed -n 's|.*/lxc/\([0-9]*\).*|\1|p')
    action=${path##*/}
    awk -v v="$vmid" '$1==v {f=1} END {exit !f}' "$SIM/db" || {
      echo "Configuration file 'nodes/x/lxc/$vmid.conf' does not exist" >&2; exit 2; }
    case $action in
      start)    new=running ;;
      shutdown) new=stopped ;;
      stop)     new=stopped ;;
      *) echo "fake pvesh: unsupported action $action" >&2; exit 99 ;;
    esac
    awk -v v="$vmid" -v s="$new" '$1==v {$2=s} {print}' "$SIM/db" > "$SIM/db.tmp" && mv "$SIM/db.tmp" "$SIM/db"
    ;;
  "delete /nodes/"*/storage/*/content/*)
    # Removing a template. This case has to come before the container delete
    # below, which would otherwise read the volid's last segment as a VMID.
    node=$(echo "$2" | sed -n 's|/nodes/\([^/]*\)/storage/.*|\1|p')
    volid=${2##*/content/}
    grep -qF "$node $volid" "$SIM/node_templates" 2>/dev/null || {
      echo "volume '$volid' does not exist" >&2; exit 2; }
    # A shared storage is one set of files, not one per node: deleting from any
    # node removes it for all of them. Modelling it per node made a removal look
    # like it had only half worked.
    store=${volid%%:*}
    if awk -v s="$store" '$2==s && $3=="1" {f=1} END {exit !f}' "$SIM/node_storages" 2>/dev/null; then
      grep -vF " $volid" "$SIM/node_templates" > "$SIM/nt.tmp" && mv "$SIM/nt.tmp" "$SIM/node_templates"
    else
      grep -vF "$node $volid" "$SIM/node_templates" > "$SIM/nt.tmp" && mv "$SIM/nt.tmp" "$SIM/node_templates"
    fi
    ;;
  "delete /nodes/"*/lxc/*/snapshot/*)
    vmid=$(echo "$2" | sed -n 's|.*/lxc/\([0-9]*\)/snapshot/.*|\1|p')
    name=${2##*/snapshot/}
    awk -v v="$vmid" '$1==v {f=1} END {exit !f}' "$SIM/db" || {
      echo "Configuration file 'nodes/x/lxc/$vmid.conf' does not exist" >&2; exit 2; }
    awk -v n="$name" '$1==n {f=1} END {exit !f}' "$SIM/snaps.$vmid" 2>/dev/null || {
      echo "snapshot '$name' does not exist" >&2; exit 2; }
    awk -v n="$name" '$1!=n' "$SIM/snaps.$vmid" > "$SIM/snaps.$vmid.tmp" && mv "$SIM/snaps.$vmid.tmp" "$SIM/snaps.$vmid"
    ;;
  "delete /nodes/"*)
    path=$2
    vmid=${path##*/}
    awk -v v="$vmid" '$1==v {f=1} END {exit !f}' "$SIM/db" || {
      echo "Configuration file 'nodes/x/lxc/$vmid.conf' does not exist" >&2; exit 2; }
    awk -v v="$vmid" '$1!=v {print}' "$SIM/db" > "$SIM/db.tmp" && mv "$SIM/db.tmp" "$SIM/db"
    ;;
  "get /cluster/nextid")
    max=$(awk 'BEGIN{m=99} $1>m {m=$1} END {print m}' "$SIM/db" 2>/dev/null || echo 99)
    echo "$((max + 1))"
    ;;
  "create /nodes/"*)
    # oci-registry-pull. The pulled file has to appear in two places: $SIM/templates,
    # which the create path's template detection reads, and $SIM/node_templates,
    # which is what a storage's content listing answers from -- `pull` reads the
    # volid back from the storage rather than composing it.
    [ -e "$SIM/fail_pull" ] && { echo "pull failed" >&2; exit 1; }
    # What Proxmox does when its pull task fails, a refused login among others
    # (#309): skopeo's reason on stdout, the failed command on stderr, nothing
    # on the storage, and exit 0.
    if [ -e "$SIM/pull_refused" ]; then
        echo "time=\"2026-10-08T22:34:16Z\" level=fatal msg=\"initializing source docker://$4: unable to retrieve auth token: invalid username/password: unauthorized: incorrect username or password\""
        echo "UPID:sim:00000001:00000001:00000001:ociregistrypull:x.tar:root@pam:"
        echo "command 'skopeo copy docker://$4 oci-archive:/var/lib/vz/template/cache/x.tar.tmp.1' failed: exit code 1" >&2
        exit 0
    fi
    node=$(echo "$2" | sed -n 's|/nodes/\([^/]*\)/storage/.*|\1|p')
    store=$(echo "$2" | sed -n 's|/nodes/[^/]*/storage/\([^/]*\)/oci-registry-pull|\1|p')
    ref=$4; tag=${ref##*:}; img=${ref%:*}; img=${img##*/}
    # The volid names the storage that was asked for, as it does on PVE. This
    # used to write local: whatever the path said, so a correct --storage on
    # create failed against the fake at pct create, not against Proxmox.
    echo "${store:-local}:vztmpl/${img}_${tag}.tar" >> "$SIM/templates"
    echo "$node ${store:-local}:vztmpl/${img}_${tag}.tar" >> "$SIM/node_templates"
    ;;
  "set /nodes/"*/lxc/*/config)
    # A container's options through its node's API -- what `update` uses for
    # a container elsewhere. Recorded like every call; nothing more to model.
    ;;
  "get /nodes/"*/lxc/*/config)
    # What `update --memory-swap` reads when no --memory came with it.
    echo '{"memory":512,"swap":512,"cores":1}'
    ;;
  *) echo "fake pvesh: unsupported $*" >&2; exit 99 ;;
esac

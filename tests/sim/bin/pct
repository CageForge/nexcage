#!/bin/bash
# Fake pct: keeps containers in $SIM/db as "vmid status name" and logs argv to
# $SIM/calls. Files named fail_* and lock.<vmid> in $SIM inject errors.
# `start` runs ../fake_init.py as the container's init and keeps its PID in
# $SIM/pid.<vmid>; the signals that init catches land in $SIM/sig.<vmid>.
SIM=${SIM:?}
HERE=$(cd "$(dirname "$0")" && pwd)
DB=$SIM/db
touch "$DB"
echo "pct $*" >> "$SIM/calls"

# The real pct sees only the node it runs on. A db row's fourth field is the
# node it lives on, absent meaning here, so a row for another node is invisible
# to every pct call -- which is the whole point of the cluster checks.
THIS_NODE=${SIM_NODE:-$(hostname)}
mine() { awk -v v="$1" -v h="$THIS_NODE" '$1==v && ($4=="" || $4==h) {f=1} END {exit !f}' "$DB"; }
exists() { mine "$1"; }
status_of() { awk -v v="$1" -v h="$THIS_NODE" '$1==v && ($4=="" || $4==h) {print $2}' "$DB"; }
set_status() { awk -v v="$1" -v s="$2" '$1==v {$2=s} {print}' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"; }
missing() { echo "Configuration file 'nodes/pve/lxc/$1.conf' does not exist" >&2; exit 2; }
# A zombie counts as gone: its new parent may not have reaped it yet
alive() { local st; st=$(awk '{print $3}' "/proc/$1/stat" 2>/dev/null) && [ -n "$st" ] && [ "$st" != Z ]; }
stop_init() {
  rm -rf "/sys/fs/cgroup/lxc/$1" 2>/dev/null
  [ -e "$SIM/pid.$1" ] || return 0
  kill -9 "$(cat "$SIM/pid.$1")" 2>/dev/null
  rm -f "$SIM/pid.$1"
}

# Start a container: a fake init per container, with a cgroup and a freezer,
# as `pct start` leaves them. Shared with `rollback --start`.
start_ct() {
  set_status "$1" running
  : > "$SIM/sig.$1"
  # A running container has a cgroup with a freezer; a stopped one does not.
  mkdir -p "/sys/fs/cgroup/lxc/$1" 2>/dev/null && echo 0 > "/sys/fs/cgroup/lxc/$1/cgroup.freeze" 2>/dev/null
  python3 "$HERE/../fake_init.py" "$SIM/sig.$1" </dev/null >/dev/null 2>&1 &
  echo $! > "$SIM/pid.$1"
  for _ in $(seq 1 50); do
    grep -qx READY "$SIM/sig.$1" 2>/dev/null && break
    sleep 0.1
  done
}
# A snapshot by name in a container's list: "name epoch description..."
has_snap() { awk -v n="$2" '$1==n {f=1} END {exit !f}' "$SIM/snaps.$1" 2>/dev/null; }

# As with LXC, a container whose init has exited is stopped
for pidfile in "$SIM"/pid.*; do
  [ -e "$pidfile" ] || continue
  alive "$(cat "$pidfile")" && continue
  rm -f "$pidfile"
  set_status "${pidfile##*.}" stopped
done

[ -e "$SIM/fail_all" ] && { cat "$SIM/fail_all" >&2; exit 13; }

cmd=$1; shift
case "$cmd" in
  list)
    printf "%-10s %-10s %-12s %-20s\n" VMID Status Lock Name
    sort -n "$DB" | while read -r v s n node; do
      [ -z "$node" ] || [ "$node" = "$THIS_NODE" ] || continue
      lock=""; [ -e "$SIM/lock.$v" ] && lock=$(cat "$SIM/lock.$v")
      printf "%-10s %-10s %-12s %-20s\n" "$v" "$s" "$lock" "$n"
    done
    ;;
  create)
    vmid=$1; tpl=$2; shift 2
    [ -e "$SIM/fail_create" ] && { cat "$SIM/fail_create" >&2; exit 255; }
    exists "$vmid" && { echo "CT $vmid already exists on node 'pve'" >&2; exit 255; }
    # Like the real pct: the template volume has to exist on the storage.
    # Archives nexcage packs itself land in $SIM/cache (see fake pvesm path).
    cached="$SIM/cache/${tpl#local:vztmpl/}"
    if [ "${tpl#local:vztmpl/}" != "$tpl" ] && [ -f "$cached" ]; then
      tar --zstd -tvf "$cached" > "$SIM/tarlist.$vmid" 2>&1 \
        || { echo "unable to create CT $vmid - broken archive '$tpl'" >&2; exit 255; }
    elif ! grep -qxF -- "$tpl" "$SIM/templates" 2>/dev/null; then
      echo "unable to create CT $vmid - volume '$tpl' does not exist" >&2; exit 255
    fi
    name=""
    while [ $# -gt 0 ]; do
      [ "$1" = "--hostname" ] && name=$2
      shift
    done
    echo "$vmid stopped $name" >> "$DB"
    echo "ostemplate: $tpl" > "$SIM/conf.$vmid"
    ;;
  start)
    exists "$1" || missing "$1"
    [ "$(status_of "$1")" = running ] && { echo "CT $1 already running" >&2; exit 255; }
    start_ct "$1"
    ;;
  shutdown|stop)
    exists "$1" || missing "$1"
    [ "$(status_of "$1")" = running ] || { echo "CT $1 not running" >&2; exit 255; }
    stop_init "$1"
    set_status "$1" stopped
    ;;
  destroy)
    exists "$1" || missing "$1"
    [ "$(status_of "$1")" = running ] && { echo "CT $1 is running - destroy failed" >&2; exit 255; }
    awk -v v="$1" '$1!=v' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
    ;;
  status)
    exists "$1" || missing "$1"
    st=$(status_of "$1")
    if [ "${2:-}" = --verbose ]; then
      # pct prints the keys sorted; pid is there only while the container runs
      echo "cpus: 1"
      echo "maxmem: 536870912"
      echo "name: $(awk -v v="$1" '$1==v {print $3}' "$DB")"
      [ "$st" = running ] && [ -e "$SIM/pid.$1" ] && echo "pid: $(cat "$SIM/pid.$1")"
      echo "status: $st"
      echo "type: lxc"
      echo "vmid: $1"
    else
      echo "status: $st"
    fi
    ;;
  exec)
    vmid=$1; shift; [ "$1" = "--" ] && shift
    exists "$vmid" || missing "$vmid"
    [ "$(status_of "$vmid")" = running ] || { echo "CT $vmid not running" >&2; exit 255; }
    # Real pct runs the command in the container and exits with its status.
    # Running it here stands in for that, so the checks can see the output and
    # the status nexcage is supposed to pass through.
    "$@"
    exit $?
    ;;
  config)
    exists "$1" || missing "$1"
    cat "$SIM/conf.$1"
    ;;
  set)
    exists "$1" || missing "$1"
    echo "set: $*" >> "$SIM/conf.$1"
    ;;
  # Snapshots: a list per container in $SIM/snaps.<vmid>, "name epoch
  # description". The refusals are pct's own words. $SIM/fail_snapshot holds
  # what pct says for a storage that cannot snapshot.
  snapshot)
    vmid=$1; name=$2; shift 2
    exists "$vmid" || missing "$vmid"
    desc=""
    while [ $# -gt 0 ]; do
      case $1 in
        --description) desc=$2; shift 2 ;;
        *) echo "fake pct: unknown snapshot option $1" >&2; exit 99 ;;
      esac
    done
    [ -e "$SIM/fail_snapshot" ] && { cat "$SIM/fail_snapshot" >&2; exit 255; }
    [ "$name" = current ] && { echo "unable to use snapshot name 'current' (reserved name)" >&2; exit 255; }
    has_snap "$vmid" "$name" && { echo "snapshot name '$name' already used" >&2; exit 255; }
    printf '%s %s %s\n' "$name" "$(date +%s)" "$desc" >> "$SIM/snaps.$vmid"
    ;;
  rollback)
    vmid=$1; name=$2; shift 2
    exists "$vmid" || missing "$vmid"
    start=0
    while [ $# -gt 0 ]; do
      case $1 in
        --start) start=$2; shift 2 ;;
        *) echo "fake pct: unknown rollback option $1" >&2; exit 99 ;;
      esac
    done
    has_snap "$vmid" "$name" || { echo "snapshot '$name' does not exist" >&2; exit 2; }
    [ "$(status_of "$vmid")" = running ] && { echo "unable to rollback vm $vmid: vm is running" >&2; exit 255; }
    echo "rollback: $name" >> "$SIM/conf.$vmid"
    # Not `[ ... ] && start_ct`: as the arm's last command its status would
    # be the script's, and a rollback without --start would "fail".
    if [ "$start" = 1 ]; then start_ct "$vmid"; fi
    ;;
  delsnapshot)
    vmid=$1; name=$2
    exists "$vmid" || missing "$vmid"
    has_snap "$vmid" "$name" || { echo "snapshot '$name' does not exist" >&2; exit 2; }
    awk -v n="$name" '$1!=n' "$SIM/snaps.$vmid" > "$SIM/snaps.$vmid.tmp" && mv "$SIM/snaps.$vmid.tmp" "$SIM/snaps.$vmid"
    ;;
  *) echo "fake pct: unsupported $cmd" >&2; exit 99 ;;
esac

#!/bin/bash
# Fake pct: keeps containers in $SIM/db as "vmid status name" and logs argv to
# $SIM/calls. Files named fail_* and lock.<vmid> in $SIM inject errors.
# `start` runs ../fake_init.py as the container's init and keeps its PID in
# $SIM/pid.<vmid>; the signals that init catches land in $SIM/sig.<vmid>.
SIM=${SIM:?}
HERE=$(cd "$(dirname "$0")" && pwd)
DB=$SIM/db
touch "$DB"
echo "pct $*" >> "$SIM/calls"

# The real pct sees only the node it runs on. A db row's fourth field is the
# node it lives on, absent meaning here, so a row for another node is invisible
# to every pct call -- which is the whole point of the cluster checks.
THIS_NODE=${SIM_NODE:-$(hostname)}
mine() { awk -v v="$1" -v h="$THIS_NODE" '$1==v && ($4=="" || $4==h) {f=1} END {exit !f}' "$DB"; }
exists() { mine "$1"; }
status_of() { awk -v v="$1" -v h="$THIS_NODE" '$1==v && ($4=="" || $4==h) {print $2}' "$DB"; }
set_status() { awk -v v="$1" -v s="$2" '$1==v {$2=s} {print}' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"; }
missing() { echo "Configuration file 'nodes/pve/lxc/$1.conf' does not exist" >&2; exit 2; }
# A zombie counts as gone: its new parent may not have reaped it yet
alive() { local st; st=$(awk '{print $3}' "/proc/$1/stat" 2>/dev/null) && [ -n "$st" ] && [ "$st" != Z ]; }
stop_init() {
  rm -rf "/sys/fs/cgroup/lxc/$1" 2>/dev/null
  [ -e "$SIM/pid.$1" ] || return 0
  kill -9 "$(cat "$SIM/pid.$1")" 2>/dev/null
  rm -f "$SIM/pid.$1"
}

# Start a container: a fake init per container, with a cgroup and a freezer,
# as `pct start` leaves them. Shared with `rollback --start`.
start_ct() {
  set_status "$1" running
  : > "$SIM/sig.$1"
  # A running container has a cgroup with a freezer; a stopped one does not.
  mkdir -p "/sys/fs/cgroup/lxc/$1" 2>/dev/null && echo 0 > "/sys/fs/cgroup/lxc/$1/cgroup.freeze" 2>/dev/null
  python3 "$HERE/../fake_init.py" "$SIM/sig.$1" </dev/null >/dev/null 2>&1 &
  echo $! > "$SIM/pid.$1"
  # Proxmox puts the init in lxc/<vmid>/ns, and kill looks for it there
  mkdir -p "/sys/fs/cgroup/lxc/$1/ns" 2>/dev/null && echo $! > "/sys/fs/cgroup/lxc/$1/ns/cgroup.procs" 2>/dev/null
  for _ in $(seq 1 50); do
    grep -qx READY "$SIM/sig.$1" 2>/dev/null && break
    sleep 0.1
  done
}
# An mpN value as PVE::JSONSchema::parse_property_string reads it against
# pve-ct-mountpoint (pve-common, pve-container's LXC/Config.pm): no newline;
# split on ','; a part without '=' is the volume; key=value parts only for
# keys the schema has; mp is required; mountoptions from Proxmox's list,
# ';'-separated; booleans as parse_boolean reads them; and neither path with
# a "." or ".." component (verify_lxc_mp_string). Errors are pct's words.
mp_check() {
  local key=$1 val=$2 part k v vol="" mp=""
  bad() { echo "400 Parameter verification failed." >&2; echo "$key: $*" >&2; return 1; }
  case $val in *$'\n'*) bad "invalid format - properties must not contain newlines"; return ;; esac
  local parts
  IFS=, read -ra parts <<< "$val"
  for part in "${parts[@]}"; do
    [[ $part =~ ^[[:space:]]*$ ]] && continue
    if [[ $part =~ ^([^=]+)=(.+)$ ]]; then
      k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
      case $k in
        mp) mp=$v ;;
        volume) [ -z "$vol" ] || { bad "invalid format - duplicate key in comma-separated list property: volume"; return; }; vol=$v ;;
        ro|acl|quota|replicate|shared|backup|keepattrs)
          [[ $v =~ ^(0|1|yes|no|on|off|true|false)$ ]] || { bad "invalid format - format error"$'\n'"$key.$k: type check ('boolean') failed - got '$v'"; return; } ;;
        mountoptions)
          [[ $v =~ ^(discard|lazytime|noatime|nodev|noexec|nosuid)(\;(discard|lazytime|noatime|nodev|noexec|nosuid))*$ ]] ||
            { bad "invalid format - format error"$'\n'"$key.mountoptions: value does not match the regex pattern"; return; } ;;
        size|idmap) ;;
        *) bad "invalid format - invalid key in comma-separated list property: $k"; return ;;
      esac
    elif [[ $part != *=* ]]; then
      [ -z "$vol" ] || { bad "invalid format - duplicate key in comma-separated list property: volume"; return; }
      vol=$part
    else
      bad "invalid format - missing key in comma-separated list property"; return
    fi
  done
  [ -n "$mp" ] || { bad "invalid format - format error"$'\n'"$key.mp: property is missing and it is not optional"; return; }
  # Not a path, so a storage volume (classify_mountpoint), which update
  # resolves through PVE::Storage::parse_volume_id
  if [[ $vol != /* && ! $vol =~ ^[a-z][a-z0-9_.-]*[a-z0-9]:.+$ ]]; then
    echo "unable to parse volume ID '$vol'" >&2; return 1
  fi
  for v in "$vol" "$mp"; do
    if [[ $v =~ /\.\.?/ || $v =~ /\.\.?$ || $v =~ ^\.\./ ]]; then bad "invalid format - $v contains illegal character sequences"; return; fi
  done
}

# A snapshot by name in a container's list: "name epoch description..."
has_snap() { awk -v n="$2" '$1==n {f=1} END {exit !f}' "$SIM/snaps.$1" 2>/dev/null; }

# As with LXC, a container whose init has exited is stopped
for pidfile in "$SIM"/pid.*; do
  [ -e "$pidfile" ] || continue
  alive "$(cat "$pidfile")" && continue
  rm -f "$pidfile"
  set_status "${pidfile##*.}" stopped
done

[ -e "$SIM/fail_all" ] && { cat "$SIM/fail_all" >&2; exit 13; }

cmd=$1; shift
case "$cmd" in
  list)
    # this host's listing failing on its own, while pvesh still answers
    [ -e "$SIM/fail_list" ] && { cat "$SIM/fail_list" >&2; exit 2; }
    printf "%-10s %-10s %-12s %-20s\n" VMID Status Lock Name
    sort -n "$DB" | while read -r v s n node; do
      [ -z "$node" ] || [ "$node" = "$THIS_NODE" ] || continue
      lock=""; [ -e "$SIM/lock.$v" ] && lock=$(cat "$SIM/lock.$v")
      printf "%-10s %-10s %-12s %-20s\n" "$v" "$s" "$lock" "$n"
    done
    # Something else on the host acting right after the listing was read,
    # once: $SIM/meanwhile.list is a script, run and removed.
    if [ -e "$SIM/meanwhile.list" ]; then bash "$SIM/meanwhile.list"; rm -f "$SIM/meanwhile.list"; fi
    ;;
  create)
    vmid=$1; tpl=$2; shift 2
    [ -e "$SIM/fail_create" ] && { cat "$SIM/fail_create" >&2; exit 255; }
    exists "$vmid" && { echo "CT $vmid already exists on node 'pve'" >&2; exit 255; }
    # Like the real pct: the template volume has to exist on the storage.
    # A pulled archive can land in $SIM/cache (see fake pvesm path).
    cached="$SIM/cache/${tpl#local:vztmpl/}"
    if [ "${tpl#local:vztmpl/}" != "$tpl" ] && [ -f "$cached" ]; then
      tar --zstd -tvf "$cached" > "$SIM/tarlist.$vmid" 2>&1 \
        || { echo "unable to create CT $vmid - broken archive '$tpl'" >&2; exit 255; }
    elif [ "${tpl#/}" != "$tpl" ]; then
      # A file path, which pct takes from root@pam (check_volume_access):
      # abs_filesystem_path wants a regular file, and tar_compression_option
      # a name that says how it is compressed. Archives nexcage packs from a
      # bundle come this way; their mode and their directory's are kept for
      # the checks.
      [ -f "$tpl" ] || { echo "unable to create CT $vmid - can't find file '$tpl'" >&2; exit 255; }
      [[ $tpl =~ \.tar(\.(gz|bz2|xz|lzo|zst))?$ ]] \
        || { echo "unable to create CT $vmid - file does not look like a template archive: $tpl" >&2; exit 255; }
      stat -c %a "$tpl" "$(dirname "$tpl")" | paste -sd' ' > "$SIM/tplmode.$vmid"
      tar --zstd -tvf "$tpl" > "$SIM/tarlist.$vmid" 2>&1 \
        || { echo "unable to create CT $vmid - broken archive '$tpl'" >&2; exit 255; }
      # fail_hang holds seconds to stand still, as an unpack does, so a
      # check can signal nexcage meanwhile; fail_hang.pid gets nexcage's PID
      # and this one's
      if [ -e "$SIM/fail_hang" ]; then
        echo "$PPID $$" > "$SIM/fail_hang.pid"
        exec sleep "$(cat "$SIM/fail_hang")"
      fi
    elif ! grep -qxF -- "$tpl" "$SIM/templates" 2>/dev/null; then
      echo "unable to create CT $vmid - volume '$tpl' does not exist" >&2; exit 255
    fi
    name=""
    while [ $# -gt 0 ]; do
      [ "$1" = "--hostname" ] && name=$2
      shift
    done
    # Real pct does the work in a task worker of its own session and waits
    # for it (PVE::RESTEnvironment::fork_worker). A TERM to pct is passed on
    # to the worker's process group, and the worker aborts and removes what it
    # had made; nothing passes a KILL on, and the worker carries on alone.
    # $SIM/slow_create holds how long the work takes, and the work also waits
    # for as long as $SIM/hold_create exists, so that a check can signal pct,
    # or change the cluster, while a create is under way, whatever the load.
    # pct names its caller's PID in $SIM/create_caller and the worker's in
    # $SIM/create_worker once a TERM would be passed on: once the worker leads
    # a process group of its own. They were named before the worker had called
    # setsid, and a TERM that came first found no group to pass on to.
    if [ -e "$SIM/slow_create" ]; then
      setsid bash -c 'sleep "$1" && while [ -e "$7" ]; do sleep 0.1; done && echo "$2 stopped $3" >> "$4" && echo "ostemplate: $5" > "$6"' \
        worker "$(cat "$SIM/slow_create")" "$vmid" "$name" "$DB" "$tpl" "$SIM/conf.$vmid" "$SIM/hold_create" &
      worker=$!
      trap 'kill -TERM -- "-$worker" 2>/dev/null; wait "$worker"; echo "received interrupt" >&2; exit 255' TERM
      while kill -0 "$worker" 2>/dev/null && [ "$(awk '{print $5}' "/proc/$worker/stat" 2>/dev/null)" != "$worker" ]; do sleep 0.01; done
      echo "$worker" > "$SIM/create_worker"
      echo "$PPID" > "$SIM/create_caller"
      wait "$worker" || exit 255
      exit 0
    fi
    echo "$vmid stopped $name" >> "$DB"
    echo "ostemplate: $tpl" > "$SIM/conf.$vmid"
    ;;
  start)
    exists "$1" || missing "$1"
    [ "$(status_of "$1")" = running ] && { echo "CT $1 already running" >&2; exit 255; }
    [ -e "$SIM/fail_start" ] && { cat "$SIM/fail_start" >&2; exit 255; }
    start_ct "$1"
    ;;
  shutdown|stop)
    exists "$1" || missing "$1"
    [ "$(status_of "$1")" = running ] || { echo "CT $1 not running" >&2; exit 255; }
    stop_init "$1"
    set_status "$1" stopped
    # Something else on the host acting while nexcage waited for the
    # shutdown, once: $SIM/meanwhile is a script, run and removed.
    if [ -e "$SIM/meanwhile" ]; then bash "$SIM/meanwhile"; rm -f "$SIM/meanwhile"; fi
    ;;
  destroy)
    exists "$1" || missing "$1"
    # $SIM/fail_destroy holds what pct says when it cannot destroy one, a
    # config lock it cannot take, say
    [ -e "$SIM/fail_destroy" ] && { cat "$SIM/fail_destroy" >&2; exit 255; }
    [ "$(status_of "$1")" = running ] && { echo "CT $1 is running - destroy failed" >&2; exit 255; }
    awk -v v="$1" '$1!=v' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
    ;;
  status)
    exists "$1" || missing "$1"
    st=$(status_of "$1")
    if [ "${2:-}" = --verbose ]; then
      # pct prints the keys sorted; pid is there only while the container runs
      echo "cpus: 1"
      echo "maxmem: 536870912"
      echo "name: $(awk -v v="$1" '$1==v {print $3}' "$DB")"
      # $SIM/reused_pid.<vmid> is the race kill has to survive: pct read the
      # init's PID, the init exited, and the PID now belongs to an unrelated
      # process -- the one the file names.
      if [ -e "$SIM/reused_pid.$1" ]; then
        echo "pid: $(cat "$SIM/reused_pid.$1")"
      elif [ "$st" = running ] && [ -e "$SIM/pid.$1" ]; then
        echo "pid: $(cat "$SIM/pid.$1")"
      fi
      echo "status: $st"
      echo "type: lxc"
      echo "vmid: $1"
    else
      echo "status: $st"
    fi
    ;;
  exec)
    vmid=$1; shift
    # pct's options come before `--`. keep-env is a boolean that defaults to 1
    # (pct.pm exec), which runs lxc-attach --keep-env: the command gets pct's
    # own environment. 0 runs --clear-env: nothing but LXC's default PATH,
    # container=lxc and the container's lxc.environment (lxc attach.c,
    # lxc_attach_set_environment).
    keep_env=1
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
      case $1 in
        --keep-env)
          case ${2-} in
            1|on|yes|true) keep_env=1 ;;
            0|off|no|false) keep_env=0 ;;
            *) echo "unable to parse boolean option" >&2; exit 255 ;;
          esac
          shift 2 ;;
        *) echo "Unknown option: ${1#--}" >&2; exit 255 ;;
      esac
    done
    [ "${1-}" = "--" ] && shift
    exists "$vmid" || missing "$vmid"
    [ "$(status_of "$vmid")" = running ] || { echo "CT $vmid not running" >&2; exit 255; }
    attach=()
    [ "$keep_env" = 0 ] && attach=(env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin container=lxc)
    # The environment the command starts with, for the checks to read
    "${attach[@]}" env > "$SIM/exec_env.$vmid"
    # Real pct runs the command in the container and exits with its status.
    # Running it here stands in for that, so the checks can see the output and
    # the status nexcage is supposed to pass through.
    "${attach[@]}" "$@"
    exit $?
    ;;
  config)
    exists "$1" || missing "$1"
    # pct prints the config's keys sorted, and the hostname is one of them
    name=$(awk -v v="$1" '$1==v {print $3}' "$DB")
    [ -n "$name" ] && echo "hostname: $name"
    # a container seeded straight into the db has no file of extra lines
    [ ! -e "$SIM/conf.$1" ] || cat "$SIM/conf.$1"
    ;;
  set)
    vmid=$1; shift
    exists "$vmid" || missing "$vmid"
    # A change pct refuses on a container that exists -- create has made it
    # and a bundle's options follow as calls of their own. $SIM/fail_set
    # holds what pct says; it exits 255, as pct does when it dies.
    [ -e "$SIM/fail_set" ] && { cat "$SIM/fail_set" >&2; exit 255; }
    # Mount points are checked as Proxmox's API checks them, all before
    # anything is written, and land in the config as `mpN: <value>`; other
    # options are logged as one `set:` line, as before.
    mps=(); rest=()
    while [ $# -gt 0 ]; do
      case $1 in
        # mp0 to mp255 (MAX_MOUNT_POINTS); Getopt::Long has no other
        --mp[0-9]*)
          [ "${1#--mp}" -le 255 ] 2>/dev/null || { echo "Unknown option: ${1#--}" >&2; echo "400 unable to parse option" >&2; exit 255; }
          mp_check "${1#--}" "$2" || exit 255; mps+=("${1#--}: $2"); shift 2 ;;
        *) rest+=("$1"); shift ;;
      esac
    done
    # A key is in the config once: a new value replaces the old one
    for line in "${mps[@]}"; do
      [ -f "$SIM/conf.$vmid" ] && sed -i "/^${line%%:*}: /d" "$SIM/conf.$vmid"
      echo "$line" >> "$SIM/conf.$vmid"
    done
    if [ ${#rest[@]} -gt 0 ]; then echo "set: $vmid ${rest[*]}" >> "$SIM/conf.$vmid"; fi
    ;;
  # Snapshots: a list per container in $SIM/snaps.<vmid>, "name epoch
  # description". The refusals are pct's own words. $SIM/fail_snapshot holds
  # what pct says for a storage that cannot snapshot.
  snapshot)
    vmid=$1; name=$2; shift 2
    exists "$vmid" || missing "$vmid"
    desc=""
    while [ $# -gt 0 ]; do
      case $1 in
        --description) desc=$2; shift 2 ;;
        *) echo "fake pct: unknown snapshot option $1" >&2; exit 99 ;;
      esac
    done
    [ -e "$SIM/fail_snapshot" ] && { cat "$SIM/fail_snapshot" >&2; exit 255; }
    [ "$name" = current ] && { echo "unable to use snapshot name 'current' (reserved name)" >&2; exit 255; }
    has_snap "$vmid" "$name" && { echo "snapshot name '$name' already used" >&2; exit 255; }
    printf '%s %s %s\n' "$name" "$(date +%s)" "$desc" >> "$SIM/snaps.$vmid"
    ;;
  rollback)
    vmid=$1; name=$2; shift 2
    exists "$vmid" || missing "$vmid"
    start=0
    while [ $# -gt 0 ]; do
      case $1 in
        --start) start=$2; shift 2 ;;
        *) echo "fake pct: unknown rollback option $1" >&2; exit 99 ;;
      esac
    done
    has_snap "$vmid" "$name" || { echo "snapshot '$name' does not exist" >&2; exit 2; }
    # Proxmox VE (AbstractConfig::snapshot_rollback) stops a running
    # container itself before rolling back -- PVE::LXC::vm_stop with kill --
    # and starts it again only with --start. Measured on 9.2, where the
    # rollback of a running container exited 0.
    if [ "$(status_of "$vmid")" = running ]; then stop_init "$vmid"; set_status "$vmid" stopped; fi
    echo "rollback: $name" >> "$SIM/conf.$vmid"
    # Not `[ ... ] && start_ct`: as the arm's last command its status would
    # be the script's, and a rollback without --start would "fail".
    if [ "$start" = 1 ]; then start_ct "$vmid"; fi
    ;;
  delsnapshot)
    vmid=$1; name=$2
    exists "$vmid" || missing "$vmid"
    has_snap "$vmid" "$name" || { echo "snapshot '$name' does not exist" >&2; exit 2; }
    awk -v n="$name" '$1!=n' "$SIM/snaps.$vmid" > "$SIM/snaps.$vmid.tmp" && mv "$SIM/snaps.$vmid.tmp" "$SIM/snaps.$vmid"
    ;;
  *) echo "fake pct: unsupported $cmd" >&2; exit 99 ;;
esac
